{
  "name": "xcode-deepseek-harness-acp",
  "version": "1.3.0",
  "private": true,
  "description": "One-click Xcode ACP integration for DeepSeek Harness",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "bin/dsh-acp-launcher.sh",
    "bin/dsh_acp_proxy.py",
    "scripts/install.sh",
    "scripts/test_acp.py",
    "scripts/xcode_mcp.py",
    "docs/XCODE_MCP.md",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
